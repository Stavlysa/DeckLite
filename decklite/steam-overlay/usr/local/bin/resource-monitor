#!/usr/bin/env bash
set -Eeuo pipefail

log_file="$HOME/resource-monitor.log"
mkdir -p "$(dirname "$log_file")"
printf '\n[%s] Starting DeckLite Resource Monitor\n' \
    "$(date --iso-8601=seconds)" >>"$log_file"

# GNOME System Monitor exits when Android denies its mandatory /proc/stat
# access. DeckLite's monitor uses Android-readable cpuidle, KGSL, meminfo and
# per-process counters instead, so its values remain live inside PRoot.
exec python3 /usr/local/bin/decklite-resource-monitor "$@" \
    >>"$log_file" 2>&1
